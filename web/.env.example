# Copy to web/.env.local (gitignored). Read by server code only, never sent to the browser.
# The server validates these at startup and exits with a list of anything missing or invalid.

# Required: where the BFF reaches the API.
API_URL=http://localhost:4000

# Optional: this app's public origin for the CSRF check. Set it behind a proxy
# that rewrites the Host header. Defaults to the request's own origin.
# APP_ORIGIN=https://payments.example.com
