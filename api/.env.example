# Copy to api/.env (gitignored). Variables already set in the shell win over this file.
# The API validates these at startup and exits with a list of anything missing or invalid.

# Required. Match docker-compose.yml at the repo root.
DATABASE_URL=postgres://payments:payments@127.0.0.1:5432/payments
REDIS_URL=redis://127.0.0.1:6379

# Optional (defaults shown).
# NODE_ENV=development
# HOST=127.0.0.1
# PORT=4000
# LOG_LEVEL=info
# TRUST_PROXY=loopback
# DB_PATH=./data/payments.db   # SQLite file that still holds the app data
# SIMULATOR=on                 # on | off
# MAX_STREAMS_PER_ORG=20
