# Copy to api/.env (gitignored). Variables already set in the shell win over this file.
# The API validates these at startup and exits with a list of anything missing or invalid.

# Required. Match docker-compose.yml at the repo root.
# The app's own login role: npm run db:migrate creates it with this name and password and
# makes it a member of payments_app. Never the superuser or table owner: the API refuses that.
DATABASE_URL=postgres://payments_app_login:payments_app_dev@127.0.0.1:5432/payments
# The schema owner (the compose superuser): only db:migrate, db:seed and tests use it.
MIGRATION_DATABASE_URL=postgres://payments:payments@127.0.0.1:5432/payments
REDIS_URL=redis://127.0.0.1:6379
# Encrypts webhook signing secrets. Generate your own: openssl rand -base64 32
# Changing it later makes existing endpoint secrets unreadable (rotate them afterwards).
WEBHOOK_SECRET_KEY=
# Let webhooks reach 127.0.0.1 for the demo receiver. Refused when NODE_ENV=production.
WEBHOOK_ALLOW_PRIVATE_TARGETS=true

# Optional (defaults shown).
# NODE_ENV=development
# HOST=127.0.0.1
# PORT=4000
# LOG_LEVEL=info
# TRUST_PROXY=loopback
# SIMULATOR=on                 # on | off. With several API instances, run it on one only.
# MAX_STREAMS_PER_ORG=20       # per API instance

# Pay-out worker (npm run worker / npm run dev:worker). Defaults shown.
# WORKER_BATCH_SIZE=5
# WORKER_POLL_MS=1000
# OUTBOX_POLL_MS=250
# PAYOUT_LEASE_MS=30000           # a crashed worker's pay-out is retried after this
# PAYOUT_MAX_ATTEMPTS=5
# PROVIDER_DECLINE_RATE=0.05      # simulated provider: final declines per attempt
# PROVIDER_TRANSIENT_RATE=0.05    # simulated provider: retryable errors per attempt
# PROVIDER_MIN_LATENCY_MS=200
# PROVIDER_MAX_LATENCY_MS=1500    # must stay under half of PAYOUT_LEASE_MS

# Webhook delivery worker (npm run webhooks / npm run dev:webhooks). Defaults shown.
# WEBHOOK_BATCH_SIZE=10
# WEBHOOK_POLL_MS=1000
# WEBHOOK_LEASE_MS=30000
# WEBHOOK_BACKOFF_BASE_MS=5000    # 5 s, 10 s, 20 s, ... up to 8 attempts, then dead

# Reports worker (npm run reports / npm run dev:reports): CSV exports and daily settlements.
# EXPORT_DIR=./var/exports        # gitignored; the API reads downloads from here too
# EXPORT_MAX_ROWS=100000          # an export matching more rows fails ("narrow the filters")
# EXPORT_MAX_BYTES=52428800       # 50 MB
# EXPORT_POLL_MS=1000
# EXPORT_LEASE_MS=60000           # a crashed export is retried after this (max 3 attempts)
# SETTLEMENT_RUN_AT=00:15         # daily, UTC; also runs at startup

# Tests (npm test). Default: the same servers as above, database payments_test and
# Redis db 15. Tests create and drop their own schemas and keys there. TEST_DATABASE_URL
# is the owner; the app side of tests uses its own login role, payments_app_test.
# TEST_DATABASE_URL=postgres://payments:payments@127.0.0.1:5432/payments_test
# TEST_REDIS_URL=redis://127.0.0.1:6379/15
