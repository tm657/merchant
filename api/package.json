{
  "name": "mini-payments-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "seed": "tsx src/seed.ts",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:create": "node-pg-migrate create --migrations-dir migrations --migration-file-language sql",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "worker": "tsx src/worker.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "webhooks": "tsx src/webhook-worker.ts",
    "dev:webhooks": "tsx watch src/webhook-worker.ts",
    "webhook-receiver": "tsx scripts/webhook-receiver.ts",
    "check-ledger": "tsx scripts/check-ledger.ts",
    "reports": "tsx src/reports-worker.ts",
    "dev:reports": "tsx watch src/reports-worker.ts",
    "settle": "tsx scripts/settle.ts",
    "test:watch": "vitest",
    "e2e:prepare": "tsx scripts/e2e-prepare.ts"
  },
  "dependencies": {
    "@mini-payments/shared": "0.1.0",
    "argon2": "0.45.1",
    "fastify": "5.12.7",
    "ioredis": "6.0.0",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "eslint": "10.13.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
