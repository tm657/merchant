{
  "name": "mini-payments",
  "private": true,
  "workspaces": [
    "packages/shared",
    "api",
    "web",
    "e2e"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev:api": "npm run dev -w api",
    "dev:web": "npm run dev -w web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test:api && npm run test:web",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "npm run migrate -w api --",
    "db:seed": "npm run seed -w api",
    "dev:worker": "npm run dev:worker -w api",
    "dev:webhooks": "npm run dev:webhooks -w api",
    "webhook-receiver": "npm run webhook-receiver -w api",
    "db:check-ledger": "npm run check-ledger -w api",
    "dev:reports": "npm run dev:reports -w api",
    "db:settle": "npm run settle -w api --",
    "test:api": "npm run test -w api",
    "test:web": "npm run test -w web",
    "test:e2e": "npm run build -w web && npm run e2e:prepare -w api && npm run test -w e2e",
    "test:e2e:dev": "npm run e2e:prepare -w api && E2E_WEB=dev npm run test -w e2e -- --grep @csp"
  }
}
