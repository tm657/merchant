{
  "name": "mini-payments",
  "private": true,
  "workspaces": [
    "packages/shared",
    "api",
    "web"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev:api": "npm run dev -w api",
    "dev:web": "npm run dev -w web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "npm run migrate -w api --",
    "db:seed": "npm run seed -w api",
    "dev:worker": "npm run dev:worker -w api",
    "dev:webhooks": "npm run dev:webhooks -w api",
    "webhook-receiver": "npm run webhook-receiver -w api"
  }
}
